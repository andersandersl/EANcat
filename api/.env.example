# Local dev only. The host platform injects PORT automatically.
PORT=8787
WEB_ORIGIN=https://shop.eanrunner.com

# Showcase Azure SQL (public-safe catalog projection — NOT production).
# A separate, isolated server populated daily by the EANRunner sync job.
SQL_SERVER=eanrunner-catalog-sql.database.windows.net
SQL_DATABASE=eanrunner-catalog-db

# Auth mode:
# - sql-password  : SQL_USER + SQL_PASSWORD (legacy)
# - entra-default : Uses Azure Default Credential chain (recommended locally)
SQL_AUTH_MODE=entra-default

# Only used when SQL_AUTH_MODE=sql-password
SQL_USER=
SQL_PASSWORD=

# Private EANrunner supplier-introduction handoff. Server-side only; never use VITE_ variables.
EANRUNNER_OPPORTUNITY_API_URL=https://private-eanrunner.example/api/opportunity-introductions
EANRUNNER_OPPORTUNITY_API_TOKEN=replace-with-private-service-token
