VITE_API_BASE_URL=http://localhost:8787

# Optional override for Vercel Opportunity Finder functions.
# Defaults to the existing public EANcat API and is used only as a read-only
# product-data source.
EANCAT_PUBLIC_API_BASE=https://eancat-api.wonderfulcliff-a6d449df.swedencentral.azurecontainerapps.io

# Optional private supplier-introduction handoff. Server-side only.
EANRUNNER_OPPORTUNITY_API_URL=https://private-eanrunner.example/api/opportunity-introductions
EANRUNNER_OPPORTUNITY_API_TOKEN=replace-with-private-service-token

# Optional explicit scan-token signing secret. If omitted, the handoff token is
# used when configured.
OPPORTUNITY_SCAN_TOKEN_SECRET=replace-with-random-secret
