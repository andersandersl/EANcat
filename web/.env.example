VITE_API_BASE_URL=http://localhost:8787

# Optional override for Vercel Opportunity Finder functions.
# Defaults to the existing public EANcat API and is used only as a read-only
# product-data source.
EANCAT_PUBLIC_API_BASE=https://eancat-api.wonderfulcliff-a6d449df.swedencentral.azurecontainerapps.io

# Retailer enquiry email delivery. Server-side only.
RESEND_API_KEY=re_replace_with_resend_api_key
RETAILER_SIGNUP_EMAIL_FROM=EANrunner <onboarding@eanrunner.com>
RETAILER_SIGNUP_EMAIL_TO=you@eanrunner.com

# Optional explicit scan-token signing secret. If omitted, the email API key is
# used when configured.
OPPORTUNITY_SCAN_TOKEN_SECRET=replace-with-random-secret
